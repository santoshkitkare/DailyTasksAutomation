# Copy to .env and fill in. .env is gitignored and never reaches the repository.

# ---------------------------------------------------------------------------
# API keys
# ---------------------------------------------------------------------------

# Anthropic - classification, summaries, greeting content.
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini - greeting image generation. Needs a billing-enabled project:
# the image models grant zero free-tier requests.
GEMINI_API_KEY=...

# Optional: Fernet key used to encrypt the stored OAuth token at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, the token is stored unencrypted with restrictive file permissions.
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Operator settings
#
# These override config.yaml. They live here rather than in the YAML because
# config.yaml is committed to a public repository and these values identify you.
# Leave a line blank to fall back to the config.yaml default - an empty value is
# treated as unset, so a stray blank line cannot silently clear a setting.
# ---------------------------------------------------------------------------

# false = act for real (label mail, send greetings). true = classify and report only.
# Ships as true in config.yaml; set this to false only once you trust the reports.
DAILY_DRY_RUN=true

# Drive file ID of the contacts workbook - the part of the share URL between
# /d/ and /edit.
DAILY_DRIVE_FILE_ID=

# Name that signs the greeting emails. Greetings will not send while empty.
DAILY_SENDER_NAME=

# Where the daily digest goes. Blank = the authenticated Gmail account itself.
DAILY_NOTIFY_RECIPIENT=

# Comma-separated substrings matched against the From header. A match vetoes
# every automated action on that message. Real bank and family domains belong
# here, not in config.yaml.
#   DAILY_PROTECTED_SENDERS=@mybank.com, mum@family.com
DAILY_PROTECTED_SENDERS=

# Optional overrides.
DAILY_TIMEZONE=
DAILY_DATABASE_URL=
