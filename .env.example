# Copy to .env and fill in. .env is gitignored.

# Anthropic — classification, summaries, greeting content.
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — greeting image generation.
GEMINI_API_KEY=...

# Optional: Fernet key used to encrypt the stored OAuth token at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, the token is stored unencrypted with restrictive file permissions.
TOKEN_ENCRYPTION_KEY=
